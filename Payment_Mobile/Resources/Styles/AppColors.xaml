<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary Color -->
    <Color x:Key="Primary">#137fec</Color>
    <Color x:Key="PrimaryDark">#0f6fd9</Color>
    <Color x:Key="PrimaryLight">#3b95f0</Color>

    <!-- Background Colors -->
    <Color x:Key="BackgroundLight">#f6f7f8</Color>
    <Color x:Key="BackgroundDark">#101922</Color>

    <!-- Gray Scale -->
    <Color x:Key="Gray50">#f9fafb</Color>
    <Color x:Key="Gray100">#f1f5f9</Color>
    <Color x:Key="Gray200">#e2e8f0</Color>
    <Color x:Key="Gray300">#cbd5e1</Color>
    <Color x:Key="Gray400">#94a3b8</Color>
    <Color x:Key="Gray500">#64748b</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1e293b</Color>
    <Color x:Key="Gray900">#0f172a</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Success">#16a34a</Color>
    <Color x:Key="Error">#dc2626</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="Info">#3b82f6</Color>

    <!-- Additional Colors -->
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>

