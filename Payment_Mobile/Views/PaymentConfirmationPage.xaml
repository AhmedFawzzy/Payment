<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Payment_Mobile.ViewModels"
             x:Class="Payment_Mobile.Views.PaymentConfirmationPage"
             x:DataType="vm:PaymentConfirmationViewModel"
             BackgroundColor="{StaticResource BackgroundLight}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Grid Grid.Row="0" 
              Padding="16,10"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource BackgroundLight}">
            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="24"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray900}"
                    Command="{Binding CloseCommand}"/>
            <Label Grid.Column="1"
                   Text="Payment Confirmation"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Button Grid.Column="2"
                    Text="Help"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}"
                    BackgroundColor="Transparent"/>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" Padding="16,32,16,24">
                <!-- Success Hero -->
                <VerticalStackLayout Spacing="24" HorizontalOptions="Center">
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            BackgroundColor="{StaticResource Primary}"
                            Opacity="0.1"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40"/>
                        </Border.StrokeShape>
                    </Border>
                    <Label Text="✓"
                           FontSize="48"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,-104,0,0"/>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Payment Successful!"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Thank you for your purchase. A receipt has been sent to your email."
                               FontSize="16"
                               TextColor="{StaticResource Gray500}"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.4"
                               MaximumWidthRequest="300"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Receipt Card -->
                <Border BackgroundColor="White"
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="10" Offset="0,4"/>
                    </Border.Shadow>

                    <VerticalStackLayout>
                        <VerticalStackLayout Padding="20" Spacing="16">
                            <Label Text="Transaction Details"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}"/>

                            <!-- Item -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </Style>
                                </Grid.Style>
                                <Label Grid.Column="0"
                                       Text="Item"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"/>
                                <Label Grid.Column="1"
                                       Text="Pro Plan (Yearly)"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

                            <!-- Price -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Grid.Column="0"
                                       Text="Price"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Purchase.FormattedAmount}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

                            <!-- Transaction ID -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Grid.Column="0"
                                       Text="Transaction ID"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Purchase.TransactionId, StringFormat='#{0}'}"
                                       FontSize="14"
                                       FontFamily="Courier"
                                       TextColor="{StaticResource Gray900}"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

                            <!-- Date -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Grid.Column="0"
                                       Text="Date"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Purchase.FormattedDate}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray900}"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

                            <!-- Payment Method -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Grid.Column="0"
                                       Text="Payment Method"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="💳"
                                           FontSize="16"/>
                                    <Label Text="{Binding Purchase.PaymentMethod, TargetNullValue='•••• 4242'}"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray900}"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Card Footer/Decorative -->
                        <BoxView HeightRequest="8" 
                                 BackgroundColor="{StaticResource Primary}"
                                 Opacity="0.2"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Total Summary -->
                <Border BackgroundColor="{StaticResource Primary}"
                        Opacity="0.05"
                        StrokeThickness="1"
                        Stroke="{StaticResource Primary}"
                        Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Total Paid"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding Purchase.FormattedAmount}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Bottom Actions -->
        <Border Grid.Row="2"
                Padding="16,12"
                BackgroundColor="{StaticResource BackgroundLight}"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.05" Radius="10" Offset="0,-4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Button Text="Return to App"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Command="{Binding ReturnToAppCommand}">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Opacity="0.25" Radius="12" Offset="0,4"/>
                    </Button.Shadow>
                </Button>

                <Border BackgroundColor="Transparent"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Button Text="View Purchase History"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Gray700}"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Command="{Binding ViewPurchaseHistoryCommand}"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

