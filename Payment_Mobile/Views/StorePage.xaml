<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Payment_Mobile.ViewModels"
             xmlns:models="clr-namespace:Payment_Mobile.Models"
             x:Class="Payment_Mobile.Views.StorePage"
             x:DataType="vm:StoreViewModel"
             BackgroundColor="{StaticResource BackgroundLight}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource BackgroundLight}"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Store"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="Restore"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        BackgroundColor="Transparent"
                        Command="{Binding RestorePurchasesCommand}"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Segmented Control -->
        <Border Grid.Row="1" 
                Margin="16,0,16,10"
                Padding="4"
                BackgroundColor="{StaticResource Gray200}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="*,*" HeightRequest="40">
                <Border Grid.Column="0" 
                        BackgroundColor="{Binding ShowSubscriptions, Converter={StaticResource SelectedBackgroundConverter}}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleViewCommand}" 
                                            CommandParameter="Subscriptions"/>
                    </Border.GestureRecognizers>
                    <Label Text="Subscriptions"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{Binding ShowSubscriptions, Converter={StaticResource SelectedTextColorConverter}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="{Binding ShowSubscriptions, Converter={StaticResource UnselectedBackgroundConverter}}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleViewCommand}" 
                                            CommandParameter="OneTime"/>
                    </Border.GestureRecognizers>
                    <Label Text="One-Time"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{Binding ShowSubscriptions, Converter={StaticResource UnselectedTextColorConverter}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2" 
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Primary}"
                          Margin="0,10"/>

        <!-- Products ScrollView -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="16" Padding="16,0,16,20">
                
                <!-- Subscriptions Section -->
                <VerticalStackLayout IsVisible="{Binding ShowSubscriptions}" Spacing="16">
                    <Label Text="Pro Access"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"/>
                    
                    <CollectionView ItemsSource="{Binding SubscriptionProducts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border Margin="0,0,0,16"
                                        Padding="20"
                                        BackgroundColor="White"
                                        Stroke="{Binding IsBestValue, Converter={StaticResource BestValueBorderConverter}}"
                                        StrokeThickness="{Binding IsBestValue, Converter={StaticResource BestValueStrokeConverter}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="10" Offset="0,4"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="16">
                                        <!-- Best Value Badge -->
                                        <Border IsVisible="{Binding IsBestValue}"
                                                BackgroundColor="{StaticResource Primary}"
                                                Padding="12,4"
                                                HorizontalOptions="Center"
                                                Margin="0,-36,0,0"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Label Text="BEST VALUE"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"/>
                                        </Border>

                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray900}"/>
                                            <Label Grid.Column="1"
                                                   Text="✓"
                                                   FontSize="24"
                                                   TextColor="{StaticResource Primary}"
                                                   IsVisible="{Binding IsBestValue}"/>
                                        </Grid>

                                        <!-- Price -->
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding FormattedPrice}"
                                                   FontSize="32"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray900}"/>
                                            <Label Text="{Binding PeriodText}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray500}"
                                                   VerticalOptions="End"
                                                   Margin="0,0,0,4"/>
                                        </HorizontalStackLayout>

                                        <!-- Save Badge -->
                                        <Label IsVisible="{Binding SavePercentage, Converter={StaticResource NotNullConverter}}"
                                               Text="{Binding SavePercentage, StringFormat='Save {0}% vs monthly'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A"/>

                                        <!-- Purchase Button -->
                                        <Button Text="{Binding HasFreeTrial, Converter={StaticResource ButtonTextConverter}}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="44"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoreViewModel}}, Path=PurchaseProductCommand}"
                                                CommandParameter="{Binding .}"/>

                                        <!-- Features -->
                                        <VerticalStackLayout Spacing="8">
                                            <CollectionView ItemsSource="{Binding Features}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Label Text="✓"
                                                                   FontSize="16"
                                                                   TextColor="{StaticResource Primary}"/>
                                                            <Label Text="{Binding .}"
                                                                   FontSize="13"
                                                                   TextColor="{StaticResource Gray600}"/>
                                                        </HorizontalStackLayout>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- One-Time Products Section -->
                <VerticalStackLayout IsVisible="{Binding ShowSubscriptions, Converter={StaticResource InvertedBoolConverter}}" 
                                    Spacing="16">
                    <Label Text="One-Time Purchases"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"/>

                    <CollectionView ItemsSource="{Binding OneTimeProducts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border Margin="0,0,0,12"
                                        Padding="12"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource Gray200}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.03" Radius="6" Offset="0,2"/>
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Icon -->
                                        <Border Grid.Column="0"
                                                WidthRequest="48"
                                                HeightRequest="48"
                                                BackgroundColor="{Binding IconColor, Converter={StaticResource IconColorConverter}}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="24"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding IconName, Converter={StaticResource IconConverter}}"
                                                   FontSize="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1" 
                                                           VerticalOptions="Center"
                                                           Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray900}"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray500}"/>
                                        </VerticalStackLayout>

                                        <!-- Price Button -->
                                        <Button Grid.Column="2"
                                                Text="{Binding FormattedPrice}"
                                                BackgroundColor="{StaticResource Gray100}"
                                                TextColor="{StaticResource Gray900}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                CornerRadius="20"
                                                Padding="16,8"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoreViewModel}}, Path=PurchaseProductCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Legal Footer -->
                <VerticalStackLayout Spacing="16" Margin="0,20,0,0">
                    <Label FontSize="10"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.4">
                        <Label.Text>
                            Subscriptions automatically renew unless auto-renew is turned off at least 24-hours before the end of the current period. Your account will be charged for renewal within 24-hours prior to the end of the current period.
                        </Label.Text>
                    </Label>
                    
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Label Text="Privacy Policy"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               TextDecorations="Underline"/>
                        <Label Text="Terms of Service"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               TextDecorations="Underline"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

