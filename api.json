      "/api/Purchases/validate": {
        "post": {
          "tags": [
            "Purchases"
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateReceiptRequest"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateReceiptRequest"
                }
              },
              "application/*+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateReceiptRequest"
                }
